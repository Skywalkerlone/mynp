    return "I would love to help with that! Could you tell me more specifically what you're looking for? I specialize in creative services, web development, AI training, social media management, and education. Feel free to ask about any of these areas!";
  }

  // ============ SAVE/LOAD MODEL ============

  async saveModel() {
    try {
      // Save model to IndexedDB
      await this.model.save('indexeddb://chatbot-model');
      console.log('💾 Model saved to IndexedDB');
      
      // Save vocabulary
      const vocabData = {
        wordIndex: this.wordIndex,
        indexWord: this.indexWord,
        maxSequenceLength: this.maxSequenceLength,
        vocabSize: this.vocabSize
      };
      localStorage.setItem('chatbot_vocab', JSON.stringify(vocabData));
      console.log('💾 Vocabulary saved to localStorage');
    } catch (error) {
      console.error('❌ Failed to save model:', error);
    }
  }

  async loadModel() {
    try {
      // Load vocabulary
      const vocabData = localStorage.getItem('chatbot_vocab');
      if (vocabData) {
        const parsed = JSON.parse(vocabData);
        this.wordIndex = parsed.wordIndex;
        this.indexWord = parsed.indexWord;
        this.maxSequenceLength = parsed.maxSequenceLength;
        this.vocabSize = parsed.vocabSize;
        console.log('📂 Vocabulary loaded from localStorage');
      } else {
        console.log('⚠️ No vocabulary found, will train from scratch');
        return false;
      }

      // Load model
      this.model = await tf.loadLayersModel('indexeddb://chatbot-model');
      this.isLoaded = true;
      console.log('📂 Model loaded from IndexedDB');
      return true;
    } catch (error) {
      console.log('⚠️ No saved model found, will train from scratch');
      return false;
    }
  }

  // ============ UTILITY METHODS ============

  getTrainingProgress() {
    return this.trainingProgress;
  }

  isModelLoaded() {
    return this.isLoaded;
  }

  isModelTraining() {
    return this.isTraining;
  }

  getModelInfo() {
    return {
      isLoaded: this.isLoaded,
      isTraining: this.isTraining,
      vocabSize: this.vocabSize,
      maxSequenceLength: this.maxSequenceLength,
      trainingDataSize: this.trainingData.length,
      progress: this.trainingProgress
    };
  }

  async reset() {
    this.model = null;
    this.isLoaded = false;
    this.trainingProgress = 0;
    this.isTraining = false;
    localStorage.removeItem('chatbot_vocab');
    try {
      await tf.io.removeModel('indexeddb://chatbot-model');
    } catch (e) {
      // Ignore if model doesn't exist
    }
    console.log('🔄 Model reset');
  }
}

// ============ EXPORT SINGLETON ============

const instance = new ChatbotModel();

// Auto-initialize
(async () => {
  try {
    const loaded = await instance.loadModel();
    if (!loaded) {
      console.log('🚀 No saved model found, training from scratch...');
      await instance.train();
    } else {
      console.log('✅ Chatbot model loaded and ready!');
    }
  } catch (error) {
    console.error('❌ Initialization failed:', error);
  }
})();

export default instance;





