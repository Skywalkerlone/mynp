  // ============ TOKENIZATION & VOCABULARY ============

  tokenize(text) {
    return text.toLowerCase()
      .replace(/[^a-z0-9\s]/g, '')
      .split(/\s+/)
      .filter(word => word.length > 0);
  }

  buildVocabulary(texts) {
    const wordCounts = {};
    
    texts.forEach(text => {
      const words = this.tokenize(text);
      words.forEach(word => {
        wordCounts[word] = (wordCounts[word] || 0) + 1;
      });
    });
    
    // Sort by frequency
    const sortedWords = Object.keys(wordCounts).sort((a, b) => wordCounts[b] - wordCounts[a]);
    
    // Build index (0=PAD, 1=UNK, then all words)
    this.wordIndex = { '<PAD>': 0, '<UNK>': 1 };
    sortedWords.forEach((word, index) => {
      this.wordIndex[word] = index + 2;
    });
    
    this.indexWord = {};
    Object.keys(this.wordIndex).forEach(key => {
      this.indexWord[this.wordIndex[key]] = key;
    });
    
    this.vocabSize = Object.keys(this.wordIndex).length;
    console.log(`📚 Vocabulary size: ${this.vocabSize} unique words`);
  }

  textToSequence(text) {
    const tokens = this.tokenize(text);
    return tokens.map(token => this.wordIndex[token] || 1); // 1 = <UNK>
  }

  padSequences(sequences) {
    return sequences.map(seq => {
      if (seq.length >= this.maxSequenceLength) {
        return seq.slice(0, this.maxSequenceLength);
      } else {
        const padded = [...seq];
        while (padded.length < this.maxSequenceLength) {
          padded.push(0); // 0 = <PAD>
        }
        return padded;
      }
    });
  }

  // ============ BUILD & TRAIN MODEL ============

  async buildModel(inputVocabSize, outputVocabSize) {
    const model = tf.sequential();

    // Embedding layer - converts word indices to dense vectors
    model.add(tf.layers.embedding({
      inputDim: inputVocabSize,
      outputDim: 128,
      inputLength: this.maxSequenceLength,
      maskZero: true,
      name: 'embedding'
    }));

    // Bidirectional LSTM for better context
    model.add(tf.layers.bidirectional({
      layer: tf.layers.lstm({
        units: 128,
        returnSequences: true,
        dropout: 0.2,
        recurrentDropout: 0.2
      }),
      mergeMode: 'concat',
      name: 'bidirectional_lstm'
    }));

    // Global average pooling
    model.add(tf.layers.globalAveragePooling1D({
      name: 'global_pooling'
    }));

    // Dense layers
    model.add(tf.layers.dense({
      units: 256,
      activation: 'relu',
      kernelRegularizer: tf.regularizers.l2({ l2: 0.001 }),
      name: 'dense_1'
    }));
    model.add(tf.layers.dropout({ rate: 0.3, name: 'dropout_1' }));

    model.add(tf.layers.dense({
      units: 128,
      activation: 'relu',
      name: 'dense_2'
    }));
    model.add(tf.layers.dropout({ rate: 0.2, name: 'dropout_2' }));

    // Output layer
    model.add(tf.layers.dense({
      units: outputVocabSize,
      activation: 'softmax',
      name: 'output'
    }));

    // Compile
    model.compile({
      optimizer: tf.train.adam(0.001),
      loss: 'sparseCategoricalCrossentropy',
      metrics: ['accuracy']
    });

    return model;
  }

  async train() {
    if (this.isTraining) {
      console.log('⚠️ Training already in progress');
      return;
    }

    this.isTraining = true;
    this.trainingProgress = 0;

    try {
      console.log('🔄 Loading training data...');
      this.trainingData = this.getTrainingData();
      console.log(`📊 Loaded ${this.trainingData.length} training examples`);

      // Prepare data
      const allInputs = this.trainingData.map(d => d.input);
      const allOutputs = this.trainingData.map(d => d.output);

      // Build vocabulary from all text
      this.buildVocabulary([...allInputs, ...allOutputs]);

      // Convert to sequences
      const inputSequences = allInputs.map(text => this.textToSequence(text));
      const outputSequences = allOutputs.map(text => this.textToSequence(text));

      // Pad sequences
      const paddedInputs = this.padSequences(inputSequences);
      const paddedOutputs = this.padSequences(outputSequences);

      // Create target (next word prediction)
      // For each output sequence, shift left by 1 to predict next word
      const targetSequences = paddedOutputs.map(seq => {
        const target = [...seq];
        target.shift(); // Remove first word
        target.push(0); // Add padding at end
        return target;
      });

      // Convert to tensors
      const inputTensor = tf.tensor2d(paddedInputs, [paddedInputs.length, this.maxSequenceLength], 'int32');
      const targetTensor = tf.tensor2d(targetSequences, [targetSequences.length, this.maxSequenceLength], 'int32');

      // Build model
      console.log('🧠 Building model...');
      this.model = await this.buildModel(this.vocabSize, this.vocabSize);

      // Log model summary
      console.log('📐 Model architecture:');
      this.model.summary();

      // Training callbacks
      const callbacks = {
        onEpochEnd: (epoch, logs) => {
          this.trainingProgress = (epoch + 1) / 100;
          console.log(`Epoch ${epoch + 1}/100: loss = ${logs.loss.toFixed(4)}, accuracy = ${(logs.acc * 100).toFixed(2)}%`);
        }
      };

      // Train
      console.log('🏋️ Starting training...');
      console.log(`📈 Training on ${inputTensor.shape[0]} samples`);

      await this.model.fit(inputTensor, targetTensor, {
        epochs: 100,
        batchSize: 32,
        shuffle: true,
        validationSplit: 0.1,
        callbacks: callbacks
      });

      // Clean up
      inputTensor.dispose();
      targetTensor.dispose();

      this.isLoaded = true;
      this.isTraining = false;
      this.trainingProgress = 1;

      console.log('✅ Training complete! Model is ready.');
      
      // Save model
      await this.saveModel();
      
      return true;
    } catch (error) {
      console.error('❌ Training failed:', error);
      this.isTraining = false;
      throw error;
    }
  }

  // ============ PREDICTION ============

  async predict(input) {
    if (!this.isLoaded) {
      console.log('⏳ Model not loaded, training first...');
      await this.train();
    }

    try {
      // Convert input to sequence
      const sequence = this.textToSequence(input);
      const padded = this.padSequences([sequence]);

      // Predict
      const inputTensor = tf.tensor2d(padded, [1, this.maxSequenceLength], 'int32');
      const prediction = this.model.predict(inputTensor);
      const predictionData = await prediction.data();

      // Get the most likely next word indices
      const indices = [];
      for (let i = 0; i < predictionData.length; i += this.vocabSize) {
        const slice = Array.from(predictionData.slice(i, i + this.vocabSize));
        const maxIndex = slice.indexOf(Math.max(...slice));
        if (maxIndex > 1) { // Skip <PAD> and <UNK>
          indices.push(maxIndex);
        }
      }

      // Convert indices to words
      const words = indices.map(idx => this.indexWord[idx] || '').filter(w => w.length > 0);
      const response = words.join(' ');

      // Clean up
      inputTensor.dispose();
      prediction.dispose();

      // If response is empty or too short, find a fallback
      if (response.length < 5) {
        return this.getFallbackResponse(input);
      }

      return response;
    } catch (error) {
      console.error('❌ Prediction failed:', error);
      return this.getFallbackResponse(input);
    }
  }

